@startuml
!theme plain

participant "GameManager" as GM
participant "TradeManager" as TM
participant "GameState" as GS
participant "MainFrame" as Frame
participant "Player1" as P1
participant "Player2" as P2
participant "TradeDialog" as Dialog

GM -> TM: startTradePhase()
TM -> Frame: enableTradeUI(true)
TM -> Frame: showMessage("取引フェーズ")

P1 -> Frame: 取引提案ボタン
Frame -> Dialog: 取引提案UI表示
Dialog -> P1: 取引内容入力\n(酒・お金)
P1 -> GM: onTradeProposed(from, to, proposal)
GM -> TM: handleTradeProposed(from, to, proposal)
TM -> Frame: showTradeOfferDialog(from, to, proposal)
Frame -> Dialog: 取引提案ダイアログ表示\n(相手プレイヤー側)

alt 取引承諾
    P2 -> Dialog: 承諾ボタン
    Dialog -> GM: onTradeResponse(proposal, true)
    GM -> TM: handleTradeResponse(proposal, true)
    TM -> GS: applyTrade(proposal)
    GS -> GS: 提案者の酒・お金を減らし\n相手に追加\n相手の酒・お金を減らし\n提案者に追加
    TM -> Frame: updateAllPlayersState(players)
    TM -> Frame: showMessage("取引成立")
else 取引拒否
    P2 -> Dialog: 拒否ボタン
    Dialog -> GM: onTradeResponse(proposal, false)
    GM -> TM: handleTradeResponse(proposal, false)
    TM -> Frame: showMessage("取引拒否")
end

P1 -> Frame: 取引フェーズ終了ボタン
Frame -> GM: onEndTradePhaseRequested()
GM -> TM: endTradePhase()
TM -> Frame: enableTradeUI(false)
TM -> GM: onTradePhaseFinished()
GM -> GM: startServePhase()

@enduml
